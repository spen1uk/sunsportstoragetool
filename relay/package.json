{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay \u2014 Sun Sport Marine communications platform",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start:server": "tsx src/server/main.ts",
    "start:worker": "tsx src/worker/main.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src web/src test scripts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sandra:fake": "tsx src/sandra/cli.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:server && npm run build:web",
    "start:prod:server": "node dist/server/main.js",
    "start:prod:worker": "node dist/worker/main.js",
    "backup": "scripts/backup.sh",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "drill:recovery": "tsx scripts/recovery-drill.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
