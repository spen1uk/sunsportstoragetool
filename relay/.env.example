# Copy to .env (never commit). Dev/test/prod must use separate databases and secrets. In production Relay REFUSES to start with development defaults (see docs/DEPLOYMENT.md).
RELAY_ENV=development
DATABASE_URL=postgres://relay:CHANGE_ME@localhost:5432/relay_dev
POSTGRES_PASSWORD=                 # docker-compose only
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000      # https://… in production
SESSION_TTL_HOURS=168
# --- secrets (generate each with: openssl rand -hex 32) ---
CREDENTIAL_KEYS={"1":"<64 hex chars>"}     # encrypts stored integration credentials. LOSE IT = stored credentials unrecoverable. Back it up separately from database backups.
CREDENTIAL_KEY_ACTIVE=1
MEDIA_SIGNING_KEY=                 # >= 24 chars
SIM_WEBHOOK_SECRET=                # >= 24 chars (simulator webhooks are disabled in production regardless)
METRICS_TOKEN=                     # optional; /metrics is 404 when unset
# --- operations ---
TRUST_PROXY=false                  # set to 1 behind exactly one reverse proxy (Caddy). Never 'true' in production.
JOB_LEASE_SECONDS=60               # how long before a crashed worker's job is picked up by another worker
BACKUP_DIR=                        # lets /api/admin/status report backup age
MEDIA_DIR=./data/media
LOG_LEVEL=info
