# Copy to .env (never commit). Dev/test/prod must use separate databases and secrets.
RELAY_ENV=development
DATABASE_URL=postgres://relay:CHANGE_ME@localhost:5432/relay_dev
PORT=4000
SESSION_TTL_HOURS=168
# Simulator webhook secret (dev only). Real providers get their own secrets via the Connections framework (Phase 5).
SIM_WEBHOOK_SECRET=change-me
# 32-byte hex key for encrypting stored integration credentials (required in production; used from Phase 5)
CREDENTIAL_KEY_HEX=
