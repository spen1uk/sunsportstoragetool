{
  "compilerOptions": {
    "target": "ES2023", "module": "esnext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "types": ["node"], "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*.ts"]
}
