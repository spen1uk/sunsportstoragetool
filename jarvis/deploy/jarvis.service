# systemd unit for running Jarvis on a small Linux server. Copy to /etc/systemd/system/jarvis.service (see docs/DEPLOY.md).
[Unit]
Description=Jarvis (personal assistant, single user)
After=network-online.target
Wants=network-online.target

[Service]
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
EnvironmentFile=/etc/jarvis.env
ExecStart=/usr/bin/node server/index.ts
Restart=always
RestartSec=5
# Hardening: it can only write its own data folder, cannot gain privileges, sees no other users' files or devices.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvis
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# (MemoryDenyWriteExecute must stay off: V8 needs it.) After the first start, check: systemd-analyze security jarvis ; journalctl -u jarvis

[Install]
WantedBy=multi-user.target
