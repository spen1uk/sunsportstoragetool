# /etc/jarvis.env  (chmod 600, owned by root). No secrets live here: the Anthropic key is set with `npm run secret:set` and stays in the data folder.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8788
JARVIS_DATA_DIR=/var/lib/jarvis
# Your private Tailscale name for this server (shown by `tailscale status`), without https://
JARVIS_ALLOWED_HOSTS=jarvis.your-tailnet.ts.net
# Tailscale provides HTTPS in front of Jarvis, so cookies become Secure and HSTS is sent
JARVIS_PUBLIC_HTTPS=1
# Where the daily encrypted backup is written (the Mac helper pulls copies from here; see docs/DEPLOY.md)
JARVIS_BACKUP_DIR=/var/backups/jarvis
# OPTIONAL outside alert: a ping address from a free "dead-man's-switch" service (https only; treat it like a password).
# If Jarvis stops checking in, that service emails/texts you. Leave blank to turn off.
# JARVIS_HEARTBEAT_URL=https://hc-ping.example/your-unique-id
